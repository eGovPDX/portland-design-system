---
import { NavItem } from "../components/nav/item";
import SiteLayout from "../layouts/site.astro";

const { frontmatter, headings, title, className } = Astro.props;
---

<SiteLayout title={title || frontmatter.title}>
  <article
    class={[
      "xl:col-span-3 px-xl xl:px-none pb-xl overflow-x-auto rich-text ",
      className,
    ]
      .filter(Boolean)
      .join(" ")}
  >
    <slot />
  </article>
  {
    headings && headings.filter((h) => h.depth > 1).length > 0 && (
      <aside class="hidden xl:block">
        <nav class="xl:p-md flex flex-col xl:max-h-dvh wrap-break-word xl:sticky xl:top-none overflow-auto">
          <h2 class="text-heading-sm">On this page</h2>
          {headings
            .filter((h) => h.depth > 1 && h.depth < 3)
            .map((h) => {
              const classes = [
                ["ml-xs", h.depth == 3],
                ["ml-sm", h.depth == 4],
                ["ml-md", h.depth == 5],
                ["ml-lg", h.depth == 6],
              ]
                .filter(([_, condition]) => condition)
                .map(([className, _]) => className)
                .join(" ");

              return (
                <NavItem as="a" href={`#${h.slug}`} className={classes}>
                  <span class="link text-body-sm font-semibold">{h.text}</span>
                </NavItem>
              );
            })}
        </nav>
      </aside>
    )
  }
</SiteLayout>
