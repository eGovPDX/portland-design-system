---
import { Box } from "@cityofportland/components-react/box";
import {
  Header,
  HeaderBranding,
  HeaderLogo,
} from "@cityofportland/components-react/header";
import { Footer } from "@cityofportland/components-react/footer";

import { SiteNav } from "./_site";

import "../styles/global.css";

const { title } = Astro.props;

const currentPath = Astro.url.pathname;

const navItems = [
  {
    href: "tokens",
    label: "Tokens",
    children: [
      { href: "tokens/background", label: "Background" },
      { href: "tokens/border", label: "Border" },
      { href: "tokens/border-width", label: "Border Width" },
      { href: "tokens/breakpoint", label: "Breakpoint" },
      { href: "tokens/color", label: "Color" },
      { href: "tokens/content", label: "Content" },
      { href: "tokens/font", label: "Font" },
      { href: "tokens/font-size", label: "Font Size" },
      { href: "tokens/line-height", label: "Line Height" },
      { href: "tokens/radius", label: "Radius" },
      { href: "tokens/scale", label: "Scale" },
      { href: "tokens/spacing", label: "Spacing" },
    ],
  },
  {
    href: "components",
    label: "Components",
    children: [{ href: "components/box", label: "Box" }],
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | design.portland.gov</title>
  </head>
  <Box
    as="body"
    color="default"
    variant="subtle"
    className="min-h-screen flex flex-col relative"
  >
    <Header color="default" variant="subtle">
      <HeaderBranding as="a" href={import.meta.env.BASE_URL}>
        <HeaderLogo />
        Design System
      </HeaderBranding>
    </Header>
    <main class="flex-1 grid grid-cols-1 xl:grid-cols-5 gap-md relative">
      <Box as="aside">
        <SiteNav
          routes={navItems}
          current={currentPath}
          className="flex flex-col xl:max-h-dvh wrap-break-word overflow-x-visible xl:sticky xl:top-none xl:overflow-y-auto"
          client:idle
        />
      </Box>
      <slot />
    </main>
    <Footer copyrightStart={2026} />
  </Box>


</html>
