{
  "name": "@cityofportland/design-tokens",
  "version": "2.0.0-alpha.7",
  "description": "Design tokens managed in Style Dictionary for the Portland Design System.",
  "author": {
    "name": "City of Portland, Oregon"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/js/base.js",
    "./*": "./dist/*.js",
    "./assets/*": "./dist/assets/*",
    "./css/*": "./dist/css/*",
    "./js/*": "./dist/js/*",
    "./json/*": "./dist/json/*",
    "./scss/*": "./dist/scss/*",
    "./tailwind/*": "./dist/tailwind/*"
  },
  "scripts": {
    "prebuild": "tsdown",
    "build": "node dist/cli/build.js --mode production",
    "build:dev": "node dist/cli/build.js --mode development",
    "clean": "rm -rf dist/",
    "dev": "node dist/cli/watch.js --mode development",
    "storybook": "storybook dev -p 6007 --no-open --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry"
  },
  "devDependencies": {
    "@storybook/addon-themes": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "colorjs.io": "^0.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "style-dictionary": "^5.8.0",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eGovPDX/portland-design-system.git"
  },
  "bugs": {
    "url": "https://github.com/eGovPDX/portland-design-system/issues"
  },
  "homepage": "https://github.com/eGovPDX/portland-design-system#readme"
}
