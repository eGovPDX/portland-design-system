{
  "name": "@cityofportland/components-react",
  "version": "1.0.0-alpha.6",
  "description": "Portland Component Library using design tokens from Figma",
  "author": {
    "name": "City of Portland, Oregon"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./*": {
      "import": "./dist/*/*.lib.es.js",
      "types": "./dist/*/*.lib.d.ts"
    },
    "./*.css": "./dist/*/*.lib.css"
  },
  "scripts": {
    "build": "vite build",
    "build:upstream": "pnpm --filter '{.}^...' build",
    "dev": "vite",
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry",
    "test": "vitest"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.4",
    "@cityofportland/components-css": "workspace:*",
    "@cityofportland/design-tokens": "workspace:*",
    "@cityofportland/icons": "workspace:*",
    "@cityofportland/types": "workspace:*",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@microsoft/api-extractor": "^7.60.1",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-themes": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@storybook/test-runner": "^0.24.5",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.12",
    "babel-jest": "^30.5.2",
    "glob": "^11.1.0",
    "identity-obj-proxy": "^3.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.6",
    "storybook-addon-pseudo-states": "^10.6.6",
    "tailwindcss": "^4.3.4",
    "unplugin-dts": "^1.1.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vitest-browser-react": "^2.3.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eGovPDX/portland-design-system.git"
  },
  "bugs": {
    "url": "https://github.com/eGovPDX/portland-design-system/issues"
  },
  "homepage": "https://github.com/eGovPDX/portland-design-system#readme"
}
