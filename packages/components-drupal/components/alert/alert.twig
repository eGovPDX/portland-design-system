{#
/**
 * @file
 * Template for Portland Alert component.
 *
 * Available variables:
 * - as: HTML element to use (div, section, article, aside)
 * - color: Box color scheme
 * - variant: Box color variation
 * - size: Alert size (default, slim)
 * - role: ARIA role (status, alert)
 * - aria-label: Accessible name for the alert
 * - dismissible: Whether the alert can be dismissed
 * - content: Alert content (slot). Compose with portland:alert-icon, portland:alert-content,
 *   portland:alert-title and portland:alert-description.
 * - attributes: Additional HTML attributes.
 */
#}

{% apply spaceless %}

	{% set element = as|default('div') %}
	{% set size = size|default('default') %}
	{% set dismissible = dismissible is defined ? dismissible : true %}
	{% set attributes = attributes|default(create_attribute()) %}

	{% if attributes.get('role') is empty and role is defined %}
		{% set attributes = attributes.setAttribute('role', role) %}
	{% elseif attributes.get('role') is empty %}
		{% set attributes = attributes.setAttribute('role', 'status') %}
	{% endif %}

	{% set aria_label = attribute(_context, 'aria-label')|default(null) %}
	{% if aria_label is not empty %}
		{% set attributes = attributes.setAttribute('aria-label', aria_label) %}
	{% elseif attributes.get('aria-label') is empty %}
		{% set label = color is defined ? color ~ ' alert' : 'alert' %}
		{% set attributes = attributes.setAttribute('aria-label', label) %}
	{% endif %}

	{% embed 'portland:box' with {
  as: element,
  color: color|default(null),
  variant: variant|default(null),
  attributes: attributes.addClass('alert', 'alert--' ~ size),
} %}
		{% block box_content %}
			{{ content }}
			{% if dismissible %}
				<span class="alert__close">
					<button type="button" class="button p-none" aria-label="Dismiss alert">
						{% include 'portland:icon' with {icon: 'xmark', size: 'sm', attributes: create_attribute().setAttribute('aria-hidden', 'true')} only %}
					</button>
				</span>
			{% endif %}
		{% endblock %}
	{% endembed %}

{% endapply %}
