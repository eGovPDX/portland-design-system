{#
/**
 * @file
 * Template for Portland Alert component.
 *
 * Available variables:
 * - as: HTML element to use (div, section, article, aside)
 * - color: Alert color scheme (default, primary, secondary, success, danger, warning, info, disabled, fixed)
 * - variant: Alert color variation (subtle, moderate, emphasis, strong, light, dark)
 * - size: Alert visual style (default, slim)
 * - role: ARIA role (status, alert)
 * - dismissible: Whether the alert can be dismissed
 * - icon: Name of an icon to show alongside the alert content
 * - title: Alert heading text
 * - title_as: HTML element for the alert title wrapper
 * - alert_content: Alert text content (slot)
 * - attributes: Additional HTML attributes
 */
#}

{% apply spaceless %}

	{% set element = as|default('div') %}
	{% set size = size|default('default') %}
	{% set role = role|default('status') %}
	{% set dismissible = dismissible is defined ? dismissible : true %}
	{% set attributes = attributes|default(create_attribute()) %}

	{% set classes = ['alert', 'alert--' ~ size] %}

	{% if attributes.get('class') is defined and attributes.get('class') is not empty %}
		{% set attribute_classes = attributes.get('class')|join(' ')|trim|split(' ') %}
		{% set attributes = attributes.removeClass(attribute_classes) %}
		{% set classes = classes|merge(attribute_classes) %}
	{% endif %}

	{% set attributes = attributes.setAttribute('role', role) %}

	{% if attributes.get('aria-label') is empty %}
		{% set attributes = attributes.setAttribute('aria-label', (color|default('')) ~ ' alert') %}
	{% endif %}

	{% embed 'portland:box' with {
  as: element,
  color: color,
  variant: variant,
  attributes: attributes.addClass(classes),
} %}
		{% block box_content %}
			{% if icon %}
				{% set alert_icon_content %}
					{% include 'portland:icon' with {icon: icon, attributes: create_attribute().setAttribute('aria-hidden', 'true')} only %}
				{% endset %}
				{% include 'portland:alert-icon' with {alert_icon_content: alert_icon_content} only %}
			{% endif %}
			{% set alert_title_content %}
				{{ title }}
			{% endset %}
			{% set alert_title_markup %}
				{% if title %}
					{% include 'portland:alert-title' with {
						as: title_as|default('header'),
						alert_title_content: alert_title_content
					} only %}
				{% endif %}
			{% endset %}
			{% set alert_description_markup %}
				{% include 'portland:alert-description' with {alert_description_content: alert_content} only %}
			{% endset %}
			{% include 'portland:alert-content' with {
				alert_content: alert_title_markup ~ alert_description_markup
			} only %}
			{% if dismissible %}
				<span class="alert__close">
					<button type="button" class="button p-none" aria-label="Dismiss alert">
						{% include 'portland:icon' with {icon: 'xmark', size: 'sm', attributes: create_attribute().setAttribute('aria-hidden', 'true')} only %}
					</button>
				</span>
			{% endif %}
		{% endblock %}
	{% endembed %}

{% endapply %}
