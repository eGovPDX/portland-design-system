{#
/**
 * @file
 * Template for Portland Header component.
 *
 * Available variables:
 * - as: HTML element type
 * - color: Header color scheme
 * - variant: Header color variation
 * - attributes: Additional HTML attributes
 * - header_branding: Branding content (slot)
 * - header_content: Navigation and action content (slot)
 */
#}

{% set attributes = attributes|default(create_attribute()) %}

{% set classes = ['header'] %}

{# Put attribute classes at the end of the class list #}
{% if attributes.get('class') is defined and attributes.get('class') is not empty %}
    {# Hack to clone the attribute classes object #}
    {% set attribute_classes = attributes.get('class')|join(' ')|trim|split(' ') %}
    {% set attributes = attributes.removeClass(attribute_classes) %}
    {% set classes = classes|merge(attribute_classes) %}
{% endif %}

{% set attributes = attributes.addClass(classes) %}

{% embed 'portland:box' with {
  as: as|default('header'),
  color,
  variant,
  attributes,
} %}
    {% block box_content %}
        {% block header_branding %}{{ header_branding }}{% endblock %}
        {% block header_content %}{{ header_content }}{% endblock %}
    {% endblock %}
{% endembed %}
