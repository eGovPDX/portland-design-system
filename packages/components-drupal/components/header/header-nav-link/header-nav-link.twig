{#
/**
 * @file
 * Template for Portland Header Nav Link component.
 */
#}

{% set attributes = attributes|default(create_attribute()) %}
{% set attributes = attributes.addClass('link') %}

{% if attributes.get('href') is empty %}
    {% set attributes = attributes.setAttribute('href', href|default('#')) %}
{% endif %}

<a {{ attributes }}>
    {% block header_nav_link_content %}{{ header_nav_link_content }}{% endblock %}
</a>
