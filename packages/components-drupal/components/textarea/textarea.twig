{% extends 'portland_components:control' %}

{% set wrapper_element = 'div' %}

{% set input_attributes = input_attributes|default(create_attribute()) %}

{% set input_attributes = input_attributes
  .setAttribute('cols', cols|default(20))
  .setAttribute('rows', rows|default(null))
  .setAttribute('autocapitalize', autoCapitalize|default(null)|escape)
  .setAttribute('spellcheck', spellCheck|default(null)|escape)
  .setAttribute('wrap', wrap|default(null)|escape)
%}

{% if autoCorrect is defined %}
  {% set input_attributes = input_attributes.setAttribute('autocorrect', autoCorrect ? 'on' : 'off') %}
{% endif %}

{% if minLength is defined and minLength is not null %}
  {% set input_attributes = input_attributes.setAttribute('minlength', minLength) %}
{% endif %}

{% if maxLength is defined and maxLength is not null %}
  {% set input_attributes = input_attributes
    .setAttribute('maxlength', maxLength)
    .setAttribute('data-character-count', id ~ '__character-count')
    .setAttribute('aria-describedby', id ~ '__character-count') %}
{% endif %}

{% block content %}
  <textarea {{ input_attributes.removeAttribute('value') }}>
    {{- value -}}
  </textarea>
{% endblock %}

{% block after %}
  {{ parent() }}
  {% if maxLength is defined and maxLength is not null %}
    <div id="{{ id ~ '__character-count' }}"></div>
  {% endif %}
{% endblock %}
