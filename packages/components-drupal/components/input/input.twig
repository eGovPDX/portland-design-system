{% set wrapper_attributes = wrapper_attributes|default(create_attribute()) %}
{% set input_attributes = input_attributes|default(create_attribute()) %}
{% set type = type|default('text') %}
{% set required = required|default(false) %}
{% set disabled = disabled|default(false) %}

{% set wrapper_attributes = wrapper_attributes.addClass(['input']) %}

{% set input_attributes = input_attributes
  .setAttribute('type', type)
  .setAttribute('name', name|default(null)|escape)
  .setAttribute('id', id|default(null)|escape)
  .setAttribute('value', value|default(null)|escape)
  .setAttribute('placeholder', placeholder|default(null)|escape)
  .setAttribute('autocomplete', autoComplete|default(null)|escape)
  .setAttribute('autofocus', autoFocus|default(null))
  .setAttribute('minlength', minLength|default(null))
  .setAttribute('maxlength', maxLength|default(null))
  .setAttribute('pattern', pattern|default(null)|escape)
  .setAttribute('accept', accept|default(null)|escape)
%}


{% if required %}
  {% set input_attributes = input_attributes.setAttribute('required', true) %}
{% endif %}

{% if disabled or state == 'disabled' %}
  {% if state is not defined %}
    {% set state = 'disabled' %}
  {% endif %}
  {% set input_attributes = input_attributes.setAttribute('disabled', true) %}
{% endif %}

{% if readOnly %}
  {% set input_attributes = input_attributes.setAttribute('readonly', true) %}
{% endif %}

{% if multiple %}
  {% set input_attributes = input_attributes.setAttribute('multiple', true) %}
{% endif %}

{% if state is defined %}
  {% set wrapper_attributes = wrapper_attributes.addClass('input--' ~ state) %}
{% endif %}

{% set describedby = input_attributes.getAttribute('aria-describedby') ? input_attributes.getAttribute('aria-describedby')|split(' ') : [] %}

{% if prefix is defined and prefix is not empty %}
  {% set describedby = describedby|merge([id ~ '__prefix']) %}
{% endif %}

{% if suffix is defined and suffix is not empty %}
  {% set describedby = describedby|merge([id ~ '__suffix']) %}
{% endif %}

<span {{ wrapper_attributes }}>
  <input {{ input_attributes.setAttribute('aria-describedby', describedby|join(' ')) }}>
  {% block prefix %}
    {{ prefix }}
  {% endblock %}
  {% block suffix %}
    {{ suffix }}
  {% endblock %}
</span>
