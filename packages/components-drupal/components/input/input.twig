{% extends 'portland_components:control' %}

{% set input_attributes = input_attributes|default(create_attribute()) %}

{% set type = type|default('text') %}

{% set input_attributes = input_attributes
  .setAttribute('type', type)
  .setAttribute('value', value|default(null)|escape)
  .setAttribute('accept', accept|default(null)|escape)
%}

{% if type in ['text', 'email', 'password', 'search', 'tel', 'url'] %}
  {% if minLength is defined and minLength is not null %}
    {% set input_attributes = input_attributes.setAttribute('minlength', minLength) %}
  {% endif %}

  {% if maxLength is defined and maxLength is not null %}
    {% set input_attributes = input_attributes.setAttribute('maxlength', maxLength) %}
  {% endif %}

  {% if pattern is defined and pattern is not null %}
    {% set input_attributes = input_attributes.setAttribute('pattern', pattern|escape) %}
  {% endif %}
{% endif %}

{% block content %}
  <input {{ input_attributes }}>
{% endblock %}
