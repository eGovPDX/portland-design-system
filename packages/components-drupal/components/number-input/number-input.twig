{% set input_attributes = input_attributes|default(create_attribute()) %}

{% set input_attributes = input_attributes
  .setAttribute('min', min|default(null))
  .setAttribute('max', max|default(null))
  .setAttribute('step', step|default(null))
  .setAttribute('list', list|default(null)|escape)
%}

{% include 'portland:input' with {
  type: 'number',
  input_attributes: input_attributes,
} %}
