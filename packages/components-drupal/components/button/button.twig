{#
/**
 * @file
 * Template for Portland Button component.
 *
 * Available variables:
 * - as: HTML element to use (button, a)
 * - color: Button color scheme
 * - variant: Button color variation
 * - size: Button size (spacing scale)
 * - outline: Whether button uses outline style
 * - type: Button type attribute (button, submit, reset)
 * - href: Link URL when rendered as an anchor
 * - disabled: Whether button is disabled
 * - attributes: Additional HTML attributes
 * - button_content: Button content (slot)
 * - left: Content to the left of default slot (slot)
 * - right: Content to the right of default slot (slot)
 */
#}

{% apply spaceless %}

{% set element = as|default('button') %}

{% if element not in ['button', 'a'] %}
  {% set element = 'button' %}
{% endif %}

{% set outline = outline|default(false) %}
{% set type = type|default('button') %}
{% set href = href|default('#') %}
{% set disabled = disabled|default(false) %}
{% set attributes = attributes|default(create_attribute()) %}


{% set attributes = attributes.addClass("button") %}

{% if size %}
  {% set attributes = attributes.addClass('button--' ~ size) %}
{% endif %}

{% if outline %}
  {% set attributes = attributes.addClass('button--outline') %}
{% endif %}

{% if disabled %}
  {% set attributes = attributes.addClass('button--disabled') %}
{% endif %}

{% if element == 'button' %}
  {% set attributes = attributes.setAttribute('type', type) %}
  {% if disabled %}
    {% set attributes = attributes.setAttribute('disabled', 'disabled') %}
  {% endif %}
{% elseif element == 'a' and attributes.get('href') is empty %}
  {% set attributes = attributes.setAttribute('href', href) %}
{% endif %}

{% embed 'portland:box' with {
  as: element,
  color,
  variant,
  
} %}
  {% block box_content %}
    {% block button_content %}
      {{ button_content }}
    {% endblock %}
  {% endblock %}
{% endembed %}

{% endapply %}
