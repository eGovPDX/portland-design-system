{% set attributes = attributes|default(create_attribute()) %}
{% set orientation = orientation|default("start") %}

{% set element = "span" %}

{% set attributes = attributes.setAttribute("id", id) %}

{% set classes = ["control__addon", "control__addon--" ~ orientation] %}

{% if decorative %}
  {% set attributes = attributes.setAttribute("aria-hidden", "true") %}
{% endif %}

{% if describeControl and not decorative %}
  {% set attributes = attributes.setAttribute("data-describe-control", true) %}
{% endif %}

{% set announcement = orientation == "start" ? "prefix" : "suffix" %}

{% set attributes = attributes.setAttribute("id", id ~ '__' ~ announcement) %}

{% apply spaceless %}
  <span {{ attributes.addClass(classes) }}>
    {% if not decorative %}
      <span class="sr-only">{{ announcement }}</span>
    {% endif %}
    {% block content %}
      {{ content }}
    {% endblock %}
  </span>
{% endapply %}
