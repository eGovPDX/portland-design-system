{
  "name": "@cityofportland/components-css",
  "version": "1.0.0-alpha.6",
  "description": "CSS component styles for the Portland Design System built with Tailwind and PostCSS",
  "author": {
    "name": "City of Portland, Oregon"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/main.css",
    "./*": "./dist/*.css",
    "./*.css": "./dist/*.css"
  },
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:upstream": "pnpm --filter '{.}^...' build",
    "clean": "rm -rf dist",
    "dev": "vite build --watch --mode development",
    "storybook": "storybook dev -p 6007 --no-open --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry"
  },
  "devDependencies": {
    "@cityofportland/design-tokens": "workspace:*",
    "@cityofportland/icons": "workspace:*",
    "@storybook/addon-themes": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.2",
    "cssnano": "^7.1.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.6",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^6.4.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eGovPDX/portland-design-system.git"
  },
  "bugs": {
    "url": "https://github.com/eGovPDX/portland-design-system/issues"
  },
  "homepage": "https://github.com/eGovPDX/portland-design-system#readme"
}
