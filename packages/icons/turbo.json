{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "tsdown.config.ts",
        "tsconfig.json",
        "package.json",
        "$TURBO_ROOT$/tsconfig.json"
      ],
      "outputs": ["dist/**"]
    }
  }
}
