{
  "name": "@cityofportland/icons",
  "version": "1.0.0-alpha.6",
  "description": "Icons used by the portland design system and its components",
  "author": {
    "name": "City of Portland, Oregon"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/js/index.js"
    },
    "./*.svg": {
      "import": "./dist/svgs/*.svg",
      "require": "./dist/svgs/*.svg"
    },
    "./*": {
      "types": "./dist/js/*.d.ts",
      "import": "./dist/js/*.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix"
  },
  "devDependencies": {
    "@cityofportland/types": "workspace:*",
    "cheerio": "^1.2.0",
    "picocolors": "^1.1.1",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2"
  },
  "optionalDependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eGovPDX/portland-design-system.git"
  },
  "homepage": "https://egovpdx.github.io/portland-design-system"
}
